{
  "name": "eurc-vault",
  "version": "0.1.0",
  "private": true,
  "description": "EURC staking vault on Solana — Anchor program, Next.js dashboard, React Native mobile",
  "workspaces": [
    "packages/*",
    "app",
    "mobile",
    "functions"
  ],
  "scripts": {
    "build:program": "anchor build",
    "test:program": "anchor test",
    "build:sdk": "npm run build -w packages/sdk",
    "dev:web": "npm run dev -w app",
    "dev:mobile": "npm run start -w mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "ts-mocha": "^11.1.0",
    "typescript": "^5.7.0"
  }
}
