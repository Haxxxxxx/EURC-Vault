# ─── Solana ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# ─── Vault (set after running create-vault script) ─────────────────────────────
# Run: cd ranger && npx tsx scripts/create-vault.ts
# Then copy the printed vault pubkey below.
NEXT_PUBLIC_VAULT_ADDRESS=

# ─── Firebase (enables live Firestore rate dashboard) ──────────────────────────
# Get from Firebase Console → Project Settings → Your Apps → Web app config.
# If omitted, the app works in demo mode with mock data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
