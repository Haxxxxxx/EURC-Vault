# ─── Solana ────────────────────────────────────────────────────────────────────
# Default: mainnet-beta (for real protocol rates via API routes)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# ─── Vault (set after deploying the vault on-chain) ──────────────────────────
# Without this, the deposit page shows "Vault Not Deployed" and transactions
# are disabled. All other pages (Dashboard, Analytics, Simulator, Activity)
# work without it using live protocol API data.
NEXT_PUBLIC_VAULT_ADDRESS=

# ─── Firebase (optional — enables real-time Firestore data) ──────────────────
# Without Firebase, the app fetches live rates from Drift/Kamino/Save APIs
# directly via Next.js API routes (/api/rates, /api/metrics).
# With Firebase, the app uses real-time Firestore listeners for instant updates
# and historical data from the scheduled Cloud Functions.
#
# Get from: Firebase Console → Project Settings → Your Apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
